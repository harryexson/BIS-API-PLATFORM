# Vite only reads .env files from this app's own directory (not the repo
# root) — copy this to apps/admin-console/.env.local for local dev.

# Stripe *publishable* key (pk_test_... / pk_live_...) — safe to expose to
# the browser, unlike the secret key the gateway uses server-side. Enables
# real Stripe.js card tokenization in the Operations tab's Request
# Playground, so a "card" payment there produces a real
# PaymentRequest.paymentToken instead of always falling back to simulated.
# Leave unset to keep the playground's card rail simulated-only.
VITE_STRIPE_PUBLISHABLE_KEY=""
