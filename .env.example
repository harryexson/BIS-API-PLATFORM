# =============================================================================
# BIS API Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/bis_platform?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Master API key for platform admin operations (generate with: openssl rand -hex 32)
PLATFORM_ADMIN_KEY=""

# HMAC secret for webhook signature verification (generate with: openssl rand -hex 32)
WEBHOOK_HMAC_SECRET=""

# Encryption key for provider secrets at rest (generate with: openssl rand -hex 32)
# Required for provider secret encryption/decryption via AES-256-GCM.
SECRET_ENCRYPTION_KEY=""

# Default lifetime (days) for newly issued/rotated API keys. Set to 0 to
# issue keys with no expiry. Applies at creation/rotation time only —
# existing keys are unaffected.
API_KEY_DEFAULT_EXPIRY_DAYS=365

# ---------------------------------------------------------------------------
# Customer account auth (signup/login — see packages/database/src/auth-registry.ts)
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=720
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Platform subscription billing (Stripe) — see packages/database/src/subscription-registry.ts
# ---------------------------------------------------------------------------
# Reuses STRIPE_SECRET_KEY (already defined below, under Payment Providers)
# to call Stripe's Customers/Subscriptions API for platform billing — a
# separate object graph from the one-off Charges API used by
# packages/providers/src/adapters/payments/stripe.ts.
# Secret used to verify the real Stripe-Signature header on the billing
# webhook route (distinct from the generic WEBHOOK_HMAC_SECRET used by
# /v1/api/webhooks/:provider, which does not use Stripe's own scheme).
STRIPE_BILLING_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Application Identity
# ---------------------------------------------------------------------------
# Unique identifier for this deployment instance
DEPLOYMENT_ID="production"

# ---------------------------------------------------------------------------
# Provider API Keys (NEVER log or expose these)
# ---------------------------------------------------------------------------
# Payment Providers
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NMI_GATEWAY_ID=""
NMI_API_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
PAWAPAY_API_KEY=""
PAYCHANGU_API_KEY=""
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""

# Messaging Providers
SIGNALHOUSE_API_KEY=""
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
FUTURESMS_API_KEY=""
FUTURESMS_BASE_URL=""

# Africa's Talking (sandbox vs. live is driven by this provider's registered
# environment, not a separate env var — see packages/providers/src/registry.ts)
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""

# Sinch SMS API (Batches endpoint). SINCH_REGION selects the regional
# endpoint Sinch serves SMS from ("us" or "eu") — defaults to "us".
SINCH_API_TOKEN=""
SINCH_SERVICE_PLAN_ID=""
SINCH_REGION="us"

# Vibes MessageAPI (XML over HTTP Basic auth). Base URL covers US/Canada SMS
# only — see packages/providers/src/adapters/messaging/vibes.ts for the
# documented confidence caveats on this adapter.
VIBES_USERNAME=""
VIBES_PASSWORD=""

# Other Providers
GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Service Configuration
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"

# Token required (via `x-admin-token` header) for provider management
# mutations in the admin console. Defaults to "dev-admin-token" when unset.
ADMIN_API_TOKEN="dev-admin-token"

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Redis URL for distributed rate limiting (optional — falls back to in-memory)
# REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Provider Circuit Breaker
# ---------------------------------------------------------------------------
# Consecutive provider failures before its circuit opens (excluded from routing)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Cooldown in ms before an open circuit allows a single recovery probe
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
RECONCILIATION_INTERVAL_MS=300000
IDEMPOTENCY_TTL_HOURS=24
