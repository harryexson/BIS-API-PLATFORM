# =============================================================================
# BIS API Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/bis_platform?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Master API key for platform admin operations (generate with: openssl rand -hex 32)
PLATFORM_ADMIN_KEY=""

# HMAC secret for webhook signature verification (generate with: openssl rand -hex 32)
WEBHOOK_HMAC_SECRET=""

# Encryption key for provider secrets at rest (generate with: openssl rand -hex 32)
# Required for provider secret encryption/decryption via AES-256-GCM.
SECRET_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Application Identity
# ---------------------------------------------------------------------------
# Unique identifier for this deployment instance
DEPLOYMENT_ID="production"

# ---------------------------------------------------------------------------
# Provider API Keys (NEVER log or expose these)
# ---------------------------------------------------------------------------
# Payment Providers
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NMI_GATEWAY_ID=""
NMI_API_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
PAWAPAY_API_KEY=""
PAYCHANGU_API_KEY=""
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""

# Messaging Providers
SIGNALHOUSE_API_KEY=""
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
FUTURESMS_API_KEY=""
FUTURESMS_BASE_URL=""

# Other Providers
GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Service Configuration
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"

# Token required (via `x-admin-token` header) for provider management
# mutations in the admin console. Defaults to "dev-admin-token" when unset.
ADMIN_API_TOKEN="dev-admin-token"

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
RECONCILIATION_INTERVAL_MS=300000
IDEMPOTENCY_TTL_HOURS=24
