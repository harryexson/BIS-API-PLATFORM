# =============================================================================
# BIS API Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/bis_platform?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# HMAC secret for webhook signature verification (generate with: openssl rand -hex 32)
WEBHOOK_HMAC_SECRET=""

# Encryption key for provider secrets at rest (generate with: openssl rand -hex 32)
# Required for provider secret encryption/decryption via AES-256-GCM.
SECRET_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Application Identity
# ---------------------------------------------------------------------------
# Unique identifier for this deployment instance
DEPLOYMENT_ID="production"

# ---------------------------------------------------------------------------
# Provider API Keys (NEVER log or expose these)
# ---------------------------------------------------------------------------
# Payment Providers
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Signing secret (whsec_...) of the Stripe webhook endpoint pointed at
# POST /v1/api/webhooks/stripe — verifies Stripe's own Stripe-Signature.
STRIPE_WEBHOOK_SECRET=""
NMI_GATEWAY_ID=""
NMI_API_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# The "secret hash" set in the Flutterwave dashboard's webhook settings;
# Flutterwave echoes it verbatim in the verif-hash header.
FLUTTERWAVE_SECRET_HASH=""
PAWAPAY_API_KEY=""
PAYCHANGU_API_KEY=""
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""
AUTHORIZENET_LOGIN_ID=""
AUTHORIZENET_TRANSACTION_KEY=""
AUTHORIZENET_SANDBOX="true"
CHECKOUT_SECRET_KEY=""
# Optional merchant-specific base URL prefix (first 8 characters of the
# environment's client_id, without "cli_"): calls go to
# https://<prefix>.api[.sandbox].checkout.com instead of the shared hosts.
CHECKOUT_API_PREFIX=""
PAYSTACK_SECRET_KEY=""

# Messaging Providers
SIGNALHOUSE_API_KEY=""
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
FUTURESMS_API_KEY=""
FUTURESMS_BASE_URL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164 sender number, or a Messaging Service SID (MG...), which is sent
# as MessagingServiceSid instead of From.
TWILIO_FROM_NUMBER=""
# WhatsApp Business Platform (Meta Cloud API, direct)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Meta App Secret — verifies X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=""
# Africa's Talking — username is "sandbox" for the sandbox app; the host
# follows the provider's registered environment ('test' → sandbox host).
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""

# Other Providers
GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Service Configuration
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"

# Admin authentication (every /api/dashboard/* and /api/observability/*
# route) — the token travels ONLY in the `x-admin-token` header, never in a
# URL. Each administrator has their OWN named credential, so every admin
# action is attributed to them in audit_logs:
#   ADMIN_API_CREDENTIALS="<id>:<sha256-hex of token>,<id>:<sha256-hex>"
# Mint one:  TOKEN=$(openssl rand -hex 32); printf %s "$TOKEN" | sha256sum
# Required in production.
ADMIN_API_CREDENTIALS=""
# Legacy single shared admin token (no identity). Accepted OUTSIDE
# production only, as the identity 'legacy-admin-token'; ignored when
# ADMIN_API_CREDENTIALS is set; refused in production.
ADMIN_API_TOKEN="dev-admin-token"
# Dedicated lockout for FAILED admin-token attempts, per caller IP
# (separate from, and stricter than, the general RATE_LIMIT_* budget).
ADMIN_AUTH_MAX_FAILURES=10
ADMIN_AUTH_FAILURE_WINDOW_MS=900000

# Secret for signing /v1/portal/* (developer-portal) session JWTs. Falls
# back to a random per-process secret when unset — fine for local dev,
# but existing portal sessions won't survive a restart. Must be set in
# production.
PORTAL_JWT_SECRET=""

# Base URL of the apps/web deployment — /v1/api/auth/signup,
# /resend-verification, and /request-password-reset emails link to
# ${PLATFORM_APP_URL}/verify-email and /reset-password. Left unset, the
# email still sends (with a relative link + the raw token as a fallback),
# it just won't be a clickable absolute URL.
PLATFORM_APP_URL="http://localhost:5176"

# Resend API key for transactional account emails (signup verification,
# password reset) — see packages/shared/src/email.ts. Left unset, sends
# are skipped (logged as a warning) and the raw token is still returned
# directly in the API response outside production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Stripe webhook signing secret for the platform's own subscription
# billing events (POST /v1/api/billing/webhooks/stripe) — NOT the same
# thing as WEBHOOK_HMAC_SECRET above, which verifies this platform's own
# provider-webhook convention, not Stripe's.
STRIPE_BILLING_WEBHOOK_SECRET=""

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:3000"

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# General budget: per application for authenticated API traffic, otherwise
# per caller IP (admin routes, unauthenticated requests, checkout reads).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Strict per-IP budget: portal login/signup and checkout pay.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
# Which reverse proxies may set the caller IP via X-Forwarded-For (per-IP
# limits and the admin lockout key on it). Unset = trust none (clients connect
# directly). Behind Railway's edge: 1 (one hop). Never "true" — refused, since
# blanket trust lets clients choose their own IP. Also accepts a comma list of
# proxy IPs/CIDRs. See docs/operations/DEPLOYMENT.md §2a.
# TRUST_PROXY=1

# Redis URL for distributed rate limiting (optional — falls back to in-memory)
# REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
RECONCILIATION_INTERVAL_MS=300000
IDEMPOTENCY_TTL_HOURS=24
